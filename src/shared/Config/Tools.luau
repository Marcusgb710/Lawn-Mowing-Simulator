local byId = {}
for _, tool in Tools.List do
	assert(not byId[tool.id], "Duplicate tool id " .. tool.id)
	byId[tool.id] = tool
	if tool.available == nil then
		tool.available = true
	end
end

function Tools.get(id: string)
	return byId[id]
end

function Tools.hasVerb(tool, verb: string): boolean
	return table.find(tool.verbs, verb) ~= nil
end

-- The finish a tool leaves, 0-1. Blade sharpness will multiply this later.
function Tools.quality(tool): number
	return tool.cutQuality or tool.quality or 0.85
end

function Tools.damagesHazards(tool): boolean
	for _, verb in tool.verbs do
		if CUTTING_VERBS[verb] then
			return true
		end
	end
	return false
end

-- Tools in a shop category, in the order they're listed above.
function Tools.inCategory(category: string, includeUnavailable: boolean?)
	local list = {}
	for _, tool in Tools.List do
		if tool.category == category and (tool.available or includeUnavailable) then
			table.insert(list, tool)
		end
	end
	return list
end

return Tools
