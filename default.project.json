{
  "name": "LawnMowingSimulator",
  "globIgnorePaths": [
    "**/*.md",
    "**/.gitkeep",
    "**/manifest"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "First": {
        "$path": "src/first"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "Decorations": {
          "$path": "assets/Decorations"
        },
        "Props": {
          "$className": "Folder",
          "FlowerPatch": {
            "$path": "assets/Props/FlowerPatch.rbxm"
          },
          "GardenGnome": {
            "$path": "assets/Props/GardenGnome.rbxm"
          }
        },
        "Story": {
          "$className": "Folder",
          "NPC_Judge1": {
            "$path": "assets/Story/NPC_Judge1.rbxm"
          },
          "NPC_Judge2": {
            "$path": "assets/Story/NPC_Judge2.rbxm"
          }
        }
      }
    },
    "ServerStorage": {
      "Assets": {
        "$path": "assets"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
