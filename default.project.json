{
  "name": "LawnMowingSimulator",
  "globIgnorePaths": [
    "**/*.md",
    "**/.gitkeep"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "First": {
        "$path": "src/first"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "assets"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
