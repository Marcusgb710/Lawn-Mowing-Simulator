--!nocheck
-- Prepares ChatGPT's model packs after File > Import 3D, for the Studio command bar.
-- Generated by scripts/generate-prepare.py from the packs' model_manifest.json files: edit
-- scripts/PrepareChatGPTModels.template.luau and run that, not the generated file.
--
-- 1. File > Import 3D, every pack's combined .gltf at once (Creator: Big Dink Studios, Scale Unit:
--    Meter, World Forward: Back, since the packs face -Z). For the high-poly pass they're in
--    ~/Desktop/LawnModelsImport/HighPoly/ALL, with their textures beside it in ../Textures.
-- 2. Paste this into the command bar. It finds every imported model, works out from each pack's
--    grid layout whether Studio turned it around, puts each model's origin at the world origin in
--    the manifest's frame, and adds:
--      * the Handle (tools) or Root part
--      * the BedArea and BaySpot parts, and the manifests' marker Attachments (Mount, FloorSpot,
--        Desk, DeliverySpot, TruckParking, DriverSeat, UseSpot, ScreenView, Contents, SnapL...)
--        with their attributes
--      * each part's collision from the manifest, and a pivot on the hinge for the parts that
--        swing or spin (doors, tailgates, ramps, flaps), since the importer centres every pivot
--    then stages them in ServerStorage.ModelImport.<Folder>.
-- 3. Right-click ServerStorage.ModelImport > Save / Export > Save to File, and run
--    `lune run scripts/export-models <file> --overwrite` to write assets/<Folder>/*.rbxm.
-- 4. Delete ServerStorage.ModelImport.

local ServerStorage = game:GetService("ServerStorage")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local MODELS = {
--@MODELS@
}
local PACKS = { --@PACKS@ }

-- Used only for a part the manifest doesn't list.
local SOLID = { Buildings = true, Trucks = true, Trailers = true, House = true }

local function parts(root: Instance): { BasePart }
	local list = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

local function bounds(list: { BasePart }): (Vector3, Vector3)
	local low, high = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in list do
		local half = part.Size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local p = part.CFrame * Vector3.new(sx * half.X, sy * half.Y, sz * half.Z)
					low = low:Min(p)
					high = high:Max(p)
				end
			end
		end
	end
	return low, high
end

-- Find the imported models: Models named after a manifest entry, in Workspace.
local found = {}
for _, d in workspace:GetDescendants() do
	if d:IsA("Model") and MODELS[d.Name] and not found[d.Name] then
		found[d.Name] = d
	end
end

local count = 0
for _ in found do
	count += 1
end
assert(count > 0, "No imported ChatGPT models found in Workspace. Import the packs' .gltf files first.")

ChangeHistoryService:SetWaypoint("Before preparing ChatGPT models")

-- The importer wraps each component in a Model ("<Asset>__Body" > MeshPart named after the mesh).
-- Flatten it so each asset holds MeshParts named "<Asset>__<Component>".
local importRoots = {}
for name, model in found do
	local root = model
	while root.Parent and root.Parent ~= workspace do
		root = root.Parent
	end
	importRoots[root] = true
	for _, child in model:GetChildren() do
		if child:IsA("Model") then
			local list = parts(child)
			for _, part in list do
				part.Name = child.Name
				part.Parent = model
			end
			if #list > 0 then
				child:Destroy()
			end
		end
	end
	for _, part in parts(model) do
		local component = part.Name:match("^[^_]+__(.+)$") or ""
		if name == "FlowerPatch" and (component:match("^Flower") or part.Name:match("^Flower%.?%d*$")) then
			part.Name = "Flower"
		end
	end
end

-- Did Studio turn a pack around? Compare its grid layout between models with the manifest.
local function layoutError(pack: string, flip: boolean): (number, number)
	local anchor, anchorCenter
	local err, n = 0, 0
	for name, model in found do
		local spec = MODELS[name]
		if spec.pack == pack then
			local low, high = bounds(parts(model))
			local center = (low + high) / 2
			local predicted = spec.layout + (spec.low + spec.high) / 2
			if flip then
				predicted = Vector3.new(-predicted.X, predicted.Y, -predicted.Z)
			end
			if not anchor then
				anchor, anchorCenter = predicted, center
			else
				err += ((center - anchorCenter) - (predicted - anchor)).Magnitude
				n += 1
			end
		end
	end
	return err, n
end

local flipped = {}
for _, pack in PACKS do
	local straight, n = layoutError(pack, false)
	local turned = layoutError(pack, true)
	flipped[pack] = n > 0 and turned < straight
	print(`{pack}: {n + 1} models, layout error straight {math.floor(straight)} vs turned {math.floor(turned)} -> {if flipped[pack] then "turned 180, fixing" else "facing right"}`)
end

local staging = ServerStorage:FindFirstChild("ModelImport") or Instance.new("Folder")
staging.Name = "ModelImport"
staging.Parent = ServerStorage

local function marker(model: Model, name: string, size: Vector3, position: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(position)
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local prepared, problems = 0, 0
for name, model in found do
	local spec = MODELS[name]
	local list = parts(model)
	local flip = flipped[spec.pack]
	local low, high = bounds(list)
	local localCenter = (spec.low + spec.high) / 2
	local turnedCenter = if flip then Vector3.new(-localCenter.X, localCenter.Y, -localCenter.Z) else localCenter
	local origin = (low + high) / 2 - turnedCenter
	local move = CFrame.Angles(0, if flip then math.pi else 0, 0) * CFrame.new(-origin)
	for _, part in list do
		part.CFrame = move * part.CFrame
	end

	-- Check it now matches the manifest's bounds in the manifest's frame.
	low, high = bounds(list)
	local off = math.max((low - spec.low).Magnitude, (high - spec.high).Magnitude)
	if off > 0.2 then
		warn(`{name}: bounds off by {string.format("%.2f", off)} studs (got {low} .. {high}, want {spec.low} .. {spec.high})`)
		problems += 1
	end

	for _, part in list do
		local info = spec.parts[part.Name]
		if not info then
			warn(`{name}: {part.Name} isn't in the manifest, so it gets the folder's default collision`)
			problems += 1
		end
		part.Anchored = true
		part.CanTouch = false
		-- Left on: players aim at tools, desks, boxes and decorations to use them, and a
		-- non-colliding part with CanQuery off is invisible to that aim.
		part.CanQuery = true
		part.CanCollide = if info then info.collide else (SOLID[spec.folder] or SOLID[name] or false)
		if part:IsA("MeshPart") then
			pcall(function()
				part.RenderFidelity = Enum.RenderFidelity.Automatic
			end)
			if info and info.fidelity then
				local ok = pcall(function()
					part.CollisionFidelity = Enum.CollisionFidelity[info.fidelity]
				end)
				if not ok then
					warn(`{name}: couldn't set {part.Name}'s CollisionFidelity to {info.fidelity}`)
					problems += 1
				end
			end
		end
		-- The game swings and spins these about their pivot, which the importer put in the middle.
		if info and info.pivot then
			part.PivotOffset = part.CFrame:ToObjectSpace(CFrame.new(info.pivot))
		end
	end

	-- Handle or Root first, so the game's fallbacks find it even if Rojo drops PrimaryPart.
	local children = model:GetChildren()
	for _, child in children do
		child.Parent = nil
	end
	local primary = marker(model, spec.primary, if spec.primary == "Handle" then Vector3.one * 0.4 else Vector3.one, spec.primaryAt)
	if spec.primary == "Root" then
		primary.PivotOffset = CFrame.new(0, -spec.primaryAt.Y, 0)
	end
	for _, child in children do
		child.Parent = model
	end
	model.PrimaryPart = primary
	model.WorldPivot = CFrame.new()

	for _, m in spec.markers do
		local p = marker(model, m.name, m.size, m.position)
		if m.slots then
			p:SetAttribute("Slots", m.slots)
		end
	end
	for _, m in spec.attachments do
		local parent = m.parent ~= "" and model:FindFirstChild(m.parent)
		if not parent then
			warn(`{name}: {m.name} belongs on {m.parent}, which isn't there; putting it on {primary.Name}`)
			problems += 1
			parent = primary
		end
		local a = Instance.new("Attachment")
		a.Name = m.name
		a.Parent = parent
		local o = m.orientation
		a.WorldCFrame = CFrame.new(m.position) * CFrame.fromOrientation(math.rad(o.X), math.rad(o.Y), math.rad(o.Z))
		for key, value in m.attributes do
			a:SetAttribute(key, value)
		end
	end
	if #spec.slots > 0 then
		local panel = model:FindFirstChild(name .. "__Body") or list[1]
		for i, position in spec.slots do
			local a = Instance.new("Attachment")
			a.Name = "Slot" .. i
			a.Parent = panel
			a.WorldCFrame = CFrame.new(position)
		end
	end

	local folder = staging:FindFirstChild(spec.folder) or Instance.new("Folder")
	folder.Name = spec.folder
	folder.Parent = staging
	local old = folder:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	model.Parent = folder
	prepared += 1
end

for root in importRoots do
	if root.Parent and #parts(root) == 0 then
		root:Destroy()
	end
end

ChangeHistoryService:SetWaypoint("Prepared ChatGPT models")
print(`Prepared {prepared} of {count} models in ServerStorage.ModelImport ({problems} warnings)`)
