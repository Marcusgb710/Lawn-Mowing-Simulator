-- The turn about Y that takes a model's front to -Z. CFrame.Angles(0, a, 0) turns a model
-- counterclockwise seen from above, so a model whose front is +X comes round at +90 degrees, one
-- whose front is -X at -90, and one that faces the camera (+Z) at 180. Every entry's up is +Y for
-- now, so there is nothing to tip.
local FACING_TURN = { ["-Z"] = 0, ["+X"] = 90, ["-X"] = -90, ["+Z"] = 180 }

-- Which side of the box each fit axis measures, once the front is -Z.
local FIT_SIDE = { height = "Y", width = "X", length = "Z" }

-- Deleted from every model: nothing a Store creator scripted, played or animated comes along.
local UNWANTED = {
	"BaseScript",
	"ModuleScript",
	"Sound",
	"ParticleEmitter",
	"Fire",
	"Smoke",
	"Sparkles",
	"PostEffect",
	"Camera",
	"LayerCollector",
	"Humanoid",
	"Constraint",
	"Motor6D",
	"WeldConstraint",
	"BodyMover",
}

local function fail(message: string)
	error(message, 0)
end

-- The part the game finds a model by: a tool's Handle, or the Root of everything else.
local function contractName(entry): string
	return if entry.folder == "Tools" then "Handle" else "Root"
end

local function partsOf(root: Instance): { BasePart }
	local list = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

-- The box around the parts, along the world's axes.
local function bounds(list: { BasePart }): (Vector3, Vector3)
	local low, high = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in list do
		local half = part.Size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local p = part.CFrame * Vector3.new(sx * half.X, sy * half.Y, sz * half.Z)
					low = low:Min(p)
					high = high:Max(p)
				end
			end
		end
	end
	return low, high
end

local function childFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder
end

-- An invisible part that only marks a place or carries the contract (Handle, Root, BedArea...).
local function marker(model: Model, name: string, size: Vector3, position: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(position)
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Parent = model
	return p
end

-- `frame` is in the model's own frame, which is the world's, since the model stands at the origin.
local function attach(parent: BasePart, name: string, frame: CFrame, attributes: { [string]: any }?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Parent = parent
	a.WorldCFrame = frame
	for key, value in attributes or {} do
		a:SetAttribute(key, value)
	end
	return a
end

local function insert(entry): Model
	local source = entry.source
	local objects
	if source.kind == "store" then
		local ok, result = pcall(function()
			return game:GetObjects("rbxassetid://" .. source.assetId)
		end)
		if not ok then
			fail(`couldn't load asset {source.assetId}: {result}`)
		end
		objects = result
	else
		-- File > Import 3D names the model after its file. A copy, so the import can be run again.
		local stem = string.match(source.file, "([^/\\]+)%.%w+$") or source.file
		for _, d in workspace:GetDescendants() do
			if d.Name == stem and (d:IsA("Model") or d:IsA("BasePart")) then
				objects = { d:Clone() }
				break
			end
		end
		if not objects then
			fail(`no model named {stem} in Workspace (File > Import 3D {source.file} first)`)
		end
	end
	if #objects == 0 then
		fail("the asset came back empty")
	end
	if #objects == 1 and objects[1]:IsA("Model") then
		return objects[1]
	end
	local wrapper = Instance.new("Model")
	wrapper.Name = entry.id
	for _, object in objects do
		object.Parent = wrapper
	end
	return wrapper
end

-- A Store "set" holds several models side by side; the entry names the one that is wanted.
local function keepOne(entry, model: Model): Model
	if not entry.keep then
		return model
	end
	local kept
	local names = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Model") then
			if d.Name == entry.keep then
				kept = d
				break
			end
			if #names < 10 then
				table.insert(names, d.Name)
			end
		end
	end
	if not kept then
		fail(`no Model named {entry.keep} in the asset (it holds {table.concat(names, ", ")})`)
	end
	kept.Parent = nil
	model:Destroy()
	return kept
end

local function clean(entry, model: Model)
	-- The entry's own list first, so a name it gives is still there to find.
	for _, item in entry.strip or {} do
		-- An empty class is the manifest's "*:Name": anything with that name, whatever it is.
		local byName = item.class == ""
		local found = 0
		for _, d in model:GetDescendants() do
			if (byName or d:IsA(item.class)) and d.Name == item.name then
				d:Destroy()
				found += 1
			end
		end
		if found == 0 then
			fail(`strip: no {if byName then "instance" else item.class} named {item.name}`)
		end
	end
	for _, d in model:GetDescendants() do
		for _, class in UNWANTED do
			if d:IsA(class) then
				d:Destroy()
				break
			end
		end
	end
	-- Seats would seat whoever touches them, and a model that sits is no use as scenery.
	for _, d in model:GetDescendants() do
		if d:IsA("Seat") or d:IsA("VehicleSeat") then
			local part = Instance.new("Part")
			part.Name = d.Name
			part.Size = d.Size
			part.CFrame = d.CFrame
			part.Color = d.Color
			part.Material = d.Material
			part.Transparency = d.Transparency
			for _, child in d:GetChildren() do
				child.Parent = part
			end
			part.Parent = d.Parent
			d:Destroy()
		end
	end
end

-- Front to -Z, the fit axis to its size, and the bottom centre on the origin.
local function normalise(entry, model: Model)
	local list = partsOf(model)
	if #list == 0 then
		fail("no parts left after cleaning")
	end
	for _, part in list do
		part.Anchored = true
	end

	-- About the world's Y axis, so it doesn't matter where the model's own pivot is. The entry's turn
	-- (for a model drawn on a diagonal, say) goes on top of the one its facing needs.
	local degrees = FACING_TURN[entry.facing] + (entry.turn or 0)
	model:PivotTo(CFrame.Angles(0, math.rad(degrees), 0) * model:GetPivot())

	local side, studs = FIT_SIDE[entry.fit.axis], entry.fit.studs
	local low, high = bounds(list)
	local now = (high - low)[side]
	if now < 0.001 then
		fail(`its {entry.fit.axis} is {now}, so it can't be scaled to {studs}`)
	end
	model:ScaleTo(model:GetScale() * studs / now)
	low, high = bounds(list)
	local got = (high - low)[side]
	if math.abs(got - studs) > studs * 0.01 then
		fail(`scaling made its {entry.fit.axis} {string.format("%.2f", got)}, not {studs} (a part hit a size limit?)`)
	end
	model:PivotTo(CFrame.new(-Vector3.new((low.X + high.X) / 2, low.Y, (low.Z + high.Z) / 2)) * model:GetPivot())
end

-- What the game expects of a model (src/shared/Assets.luau): the Handle or Root, and the entry's extras.
-- Returns how many things the mesh already had under the Handle or Root name, which it renamed.
local function contract(entry, model: Model): number
	local list = partsOf(model)
	local handleName = contractName(entry)

	-- The entry's collision for the mesh's own parts: all of them, then the ones it names. Queries
	-- stay on and touches off: players aim at tools, desks and decorations to use them, and a
	-- non-colliding part with CanQuery off is invisible to that aim. (The invisible markers made
	-- further down keep CanQuery off.)
	for _, part in list do
		part.CanCollide = entry.collide
		part.CanQuery = true
		part.CanTouch = false
	end
	-- Every name here is the mesh's own, so find all the parts before renaming any of them.
	local steps = {}
	for name, info in entry.parts or {} do
		local found = 0
		for _, part in list do
			if part.Name == name then
				table.insert(steps, { part = part, info = info })
				found += 1
			end
		end
		if found == 0 then
			fail(`parts: no part named {name}`)
		end
	end
	local handleMesh
	if entry.handlePart then
		for _, part in list do
			if part.Name == entry.handlePart then
				handleMesh = part
				break
			end
		end
		if not handleMesh then
			fail(`handlePart: no part named {entry.handlePart}`)
		end
	end
	for _, step in steps do
		if step.part ~= handleMesh and step.info.rename == handleName then
			fail(`parts: {step.part.Name} can't be renamed {handleName}, which is the importer's own (use handlePart)`)
		end
	end
	for _, step in steps do
		if step.info.collide ~= nil then
			step.part.CanCollide = step.info.collide
		end
		if step.info.rename then
			step.part.Name = step.info.rename
		end
	end
	-- A truck whose parts are all called "Part" has nothing to find its body by, so the entry can ask
	-- for the largest visible one (by box volume) to be named. After the renames above, so a name the
	-- entry gave is not undone, and a clash with one of them is a FAIL, not a quiet second Body.
	if entry.body == "largest" then
		local bodyName = entry.id .. "__Body"
		local body, biggest = nil, 0
		for _, part in list do
			if part.Name == bodyName then
				fail(`body: a part is already named {bodyName} (parts renamed one to it?), so "largest" can't take it`)
			end
			if part.Transparency < 1 then
				local volume = part.Size.X * part.Size.Y * part.Size.Z
				if volume > biggest then
					body, biggest = part, volume
				end
			end
		end
		if not body then
			fail("body: no visible part to name")
		end
		body.Name = bodyName
	end
	-- A Store mesh often has its own Handle (a handlebar group, say), and the game finds ours with
	-- FindFirstChild, so two would be a coin toss. Whatever is left with the name moves aside.
	local clashes = 0
	for _, d in model:GetDescendants() do
		if d.Name == handleName and d ~= handleMesh then
			d.Name = handleName .. "_mesh"
			clashes += 1
		end
	end
	if handleMesh then
		handleMesh.Name = handleName
	end

	local primary = handleMesh
	if not primary then
		if entry.folder == "Tools" then
			primary = marker(model, "Handle", entry.handle.size, entry.handle.position)
		else
			primary = marker(model, "Root", Vector3.one, Vector3.new(0, 0.5, 0))
			-- So the model's pivot is its origin on the ground, where Assets.placeAt puts it.
			primary.PivotOffset = CFrame.new(0, -0.5, 0)
		end
	end
	model.PrimaryPart = primary
	model.WorldPivot = CFrame.new()

	if entry.grips then
		attach(primary, "GripLeft", CFrame.new(entry.grips.left))
		attach(primary, "GripRight", CFrame.new(entry.grips.right))
	end
	for _, m in entry.markers or {} do
		local o = m.orientation
		local turn = CFrame.fromOrientation(math.rad(o.X), math.rad(o.Y), math.rad(o.Z))
		attach(primary, m.name, CFrame.new(m.position) * turn, m.attributes)
	end
	for _, box in entry.boxes or {} do
		marker(model, box.name, box.size, box.position)
	end
	-- Plain parts for what a fused mesh lacks (an equipment trailer's ramp); the hinge is its pivot.
	for _, s in entry.synth or {} do
		local part = Instance.new("Part")
		part.Name = s.name
		part.Size = s.size
		part.CFrame = CFrame.new(s.position)
		part.Material = Enum.Material[s.material]
		part.Color = s.color
		part.Anchored = true
		part.CanTouch = false
		if s.hinge then
			part.PivotOffset = part.CFrame:ToObjectSpace(CFrame.new(s.hinge))
		end
		part.Parent = model
	end
	return clashes
end

local function stage(entry, model: Model)
	local staging = childFolder(ServerStorage, "ModelImport")
	local folder = childFolder(staging, entry.folder)
	local old = folder:FindFirstChild(entry.id)
	if old then
		old:Destroy()
	end
	model.Name = entry.id
	model.Parent = folder
end

ChangeHistoryService:SetWaypoint("Before importing Store models")

local staged, failed = 0, 0
for _, entry in MODELS do
	local model
	local ok, result = pcall(function()
		model = insert(entry)
		model = keepOne(entry, model)
		clean(entry, model)
		normalise(entry, model)
		local clashes = contract(entry, model)
		local list = partsOf(model)
		local low, high = bounds(list)
		local size = high - low
		local line = string.format("ok %s parts=%d size=%.1fx%.1fx%.1f", entry.id, #list, size.X, size.Y, size.Z)
		if clashes > 0 then
			line ..= ` (renamed {clashes} {contractName(entry)} clashes)`
		end
		if entry.budget and #list > entry.budget then
			line ..= ` (over its budget of {entry.budget} parts)`
		end
		stage(entry, model)
		return line
	end)
	if ok then
		staged += 1
		print(result)
	else
		failed += 1
		if model then
			model:Destroy()
		end
		print(`FAIL {entry.id} {result}`)
	end
end

ChangeHistoryService:SetWaypoint("Imported Store models")
print(`staged {staged}, failed {failed}`)
